{# EVERY AREA, LIVE — one plate, every boundary, every position.

   TWO COLUMNS: the map in its 768:560 box, capped at 540 px, and every
   area's rangers beside it. What needs an answer is the banner above. #}
{% extends '@UhifadhiRoster/org/base.html.twig' %}

{% block title %}Roster · live · {{ scope.label }}{% endblock %}

{% block roster_org_page %}
    {{ include('@UhifadhiRoster/org/_banner.html.twig', {decisions: decisions, word: 'answer', door: {label: 'Today', route: constant('Uhifadhi\\Roster\\Controller\\RosterOrgController::TODAY_ROUTE')}}, with_context: false) }}

    <div class="grid g32">
        <div class="c">
            <span class="tab">Every area, live<span class="src">&middot; <time datetime="{{ now.format('c') }}" data-localtime-format="time">{{ now.format('H:i') }}</time> &middot; {{ areas|length }} area{{ areas|length == 1 ? '' : 's' }}</span></span>
            {% if plate %}
                <div>{{ render_map(plate, {"--map-plate-height": "min(540px, calc((100vw - 120px) * .6 * 560 / 768))"}) }}</div>
            {% else %}
                <div class="rfrag"><b>No area has a boundary to draw</b><em>a map is the area&rsquo;s ground; without one there is nothing to put the positions on</em></div>
            {% endif %}
        </div>

        <div class="c">
            <span class="tab">Rangers, every area<span class="src">&middot; {{ rows|length }}</span></span>
            {{ include('@UhifadhiRoster/org/_filters.html.twig', {
                here: constant('Uhifadhi\\Roster\\Controller\\RosterOrgController::LIVE_ROUTE'), chosen: chosen, options: options, total: options.area|reduce((sum, o) => sum + o.count, 0),
            }, with_context: false) }}
            <table class="tbl ro-tbl">
                <thead><tr><th>Area</th><th>Ranger</th><th>Post</th><th>Presence</th><th class="num">Ping age</th></tr></thead>
                <tbody>
                {% for row in table.rows %}
                    {%- set seen = row.person.lastSeenAt -%}
                    <tr>
                        <td><span class="orgarea" data-cat="{{ row.position }}"><i></i>{{ row.areaName }}</span></td>
                        <td><b>{{ row.person.personName }}</b></td>
                        <td>{{ row.post.stationName }}</td>
                        <td><span class="r-ci {{ row.person.state.value }}"><i></i>{{ row.person.state.label }}</span></td>
                        <td class="num"><span class="mono d">{% if seen %}<time datetime="{{ seen.format('c') }}" data-localtime-format="time">{{ seen.format('H:i') }}</time>{% else %}&mdash;{% endif %}</span></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="fog">{{ chosen|filter(v => v is not null) is empty ? 'Nobody is due in any area today.' : 'Nobody matches.' }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
            {{ include('@Shell/_foot.html.twig', table.foot, with_context: false) }}
            <div class="use"><b>The area is named on every row.</b> Narrow the scope and the same rows remain, minus the areas you dropped.</div>
        </div>
    </div>
{% endblock %}

{# ============================================================================
   THE CALENDAR — one ranger's month, drawn in the HOUSE calendar.

   THE ATLAS OWNS THE MONTH. The grid, the day head, the cell, its fixed
   height, the day number, the "+N more" and the stepper all come from
   `atlas_calendar()`; this module ships no month grid of its own and says
   only what happened on which day. That is the whole bargain of the
   component, and the reason a busy week cannot make the month taller than a
   quiet one.

   A PAST DAY CARRIES WHAT THE CHECK-IN RECORDED AND A FUTURE DAY WHAT THE
   ROTATION PLANS. The two never wear the same mark: a stood watch is
   hollow — finished — and one still to come is open.
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · calendar{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}One ranger&rsquo;s month &mdash; the same format the handset draws.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / calendar{% endblock %}

{% block roster_page %}
    {% if chosen is null %}
        <div class="c">
            <span class="tab">The month</span>
            <div class="rfrag"><b>No rotation in this area draws from anybody yet</b><em>a month is one ranger&rsquo;s watches, and there is nobody in a pool to show one for</em></div>
        </div>
    {% else %}
        <h2 class="zone">{{ chosen.name }} &mdash; {{ month.label|lower }}</h2>
        <div class="c">
            {# THE CAPTION CARRIES WHO, WHAT THEY ARE AND WHERE — the design's
               own fields. A month with only a name on it makes the reader
               check the picker to know whose it is. #}
            <span class="tab">The month<span class="src">&middot; {{ chosen.name }}{% if chosen.role %} &middot; {{ chosen.role }}{% endif %}{% if chosen.post %} &middot; {{ chosen.post }}{% endif %} &middot; {{ figures.watches }} watch{{ figures.watches == 1 ? '' : 'es' }} &middot; {{ figures.nights }} night{{ figures.nights == 1 ? '' : 's' }}</span></span>
            {% if chosen.postUrl %}<a class="more" href="{{ chosen.postUrl }}">The post &rarr;</a>{% endif %}

            {# THE RANGER PICKER — the shell's dropdown, searchable, in the
               month's own nav row through the atlas's `controls` slot. It is
               a GET form: a choice is carried into its field and sent
               (`roster--filter`), so a chosen ranger is an address somebody
               can send, and the month stays the one on screen. #}
            {% set rangerPicker %}
                <form method="get" action="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid}) }}" data-controller="roster--filter" data-action="uhifadhi--shell-bundle--dropdown:choose->roster--filter#chosen">
                    <input type="hidden" name="month" value="{{ month.year ~ '-' ~ '%02d'|format(month.month) }}">
                    <input type="hidden" name="ranger" value="{{ chosen.uuid }}">
                    {{ include('@Shell/_dropdown.html.twig', {
                        name: 'ranger', label: 'Choose a ranger', icon: 'shell:user-round', default: chosen.uuid, value: chosen.uuid,
                        searchable: true, end: true, search: 'Find a ranger…', none: 'No ranger matches.',
                        groups: [{label: 'Rangers', options: people|map(person => {value: person.uuid, label: person.name, count: null})}],
                    }, with_context: false) }}
                </form>
            {% endset %}

            {# The feed is handed over by the controller rather than reached
               for as a global: a template that resolved a service would be a
               template with a container in it. #}
            {{ atlas_calendar(
                feed,
                month,
                scope,
                previousUrl: path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid, ranger: chosen.uuid, month: month.previous.year ~ '-' ~ '%02d'|format(month.previous.month)}),
                nextUrl: path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid, ranger: chosen.uuid, month: month.next.year ~ '-' ~ '%02d'|format(month.next.month)}),
                controls: rangerPicker
            ) }}
        </div>
    {% endif %}
{% endblock %}

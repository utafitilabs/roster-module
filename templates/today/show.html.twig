{# ============================================================================
   TODAY — the agenda, ported from the design's modules/roster/today.html.

   THE PAGE IS: the band, the filter row, the five figures, TODAY, then
   TOMORROW. Two days and no more — the agenda's whole trade-off is that it
   answers "what is happening" completely and says nothing about the week,
   which is the next tab's job and its door is on the second card.

   THE FIGURES ARE OF THE WHOLE DAY, NOT OF THE FILTER. Narrowing to one post
   must not quietly change "2 need an answer" into "2 of the ones you are
   looking at".
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · today{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}Who is due, and what the positions say about them. The watch is the roster&rsquo;s; the state beside it is the area&rsquo;s reading of a ranger&rsquo;s own check-in.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / today{% endblock %}

{% block roster_page %}
    {{ include('@UhifadhiRoster/_identity_band.html.twig') }}

    {{ include('@UhifadhiRoster/today/_filters.html.twig') }}

    <div class="grid kstrip">
        <div class="c kpi hot" data-kpi="on-the-watch">
            <span class="tab">On the watch</span>
            <b class="disp">{{ figures.onTheWatchNow }}<em>now</em></b>
            <span class="sub">+{{ figures.onTheWatchTomorrow }} tomorrow &middot; {{ figures.dueLaterToday }} later today</span>
        </div>
        {# VERIFIED IS A FRAGMENT OF CHECK-INS IN, not a card of its own —
           a row is four cards, never five. It reads better folded: how
           many came in, and how many of them the pings bore out, is one
           thought and two numbers. #}
        <div class="c kpi" data-kpi="check-ins-in">
            <span class="tab">Check-ins in</span>
            <b class="disp">{{ figures.day.checkedIn }}<em>of {{ figures.day.expected }} expected</em></b>
            <span class="sub">{{ figures.day.verified }} verified at a post &middot; {{ figures.dueLaterToday }} not due until their watch begins</span>
        </div>
        <div class="c kpi{{ figures.needingAnAnswer > 0 ? ' bad' : '' }}" data-kpi="needs-an-answer">
            <span class="tab">Needs an answer</span>
            <b class="disp">{{ figures.needingAnAnswer }}</b>
            <span class="sub">{% if figures.needingAnAnswer > 0 %}<span class="r">{{ figures.day.flagged }} unverified &middot; {{ figures.day.noCheckIn }} no check-in</span>{% else %}nothing is waiting on anybody{% endif %}</span>
        </div>
        <div class="c kpi" data-kpi="holes">
            <span class="tab">Holes</span>
            <b class="disp">{{ figures.holesNextTwoDays }}<em>next {{ constant('Uhifadhi\\Roster\\Service\\AgendaService::HOLE_DAYS') }} days</em></b>
            <span class="sub">{% if figures.holesNextTwoDays > 0 %}<span class="r">a watch the pattern asked for and nobody is on</span>{% else %}every watch the pattern asked for is filled{% endif %}</span>
        </div>
    </div>

    {# THE DAY'S CARD IS BOUNDED — RULED 25 sep, the sheet's height rule
       (`roster--bound`, `.rscroll`): the agenda scrolls inside it under its
       tab, and never grows with the posts. #}
    <h2 class="zone">{{ isToday ? 'Today' : 'The day' }}</h2>
    <div class="c" data-controller="roster--bound">
        <span class="tab">{{ isToday ? 'Today' : 'The day' }}<span class="src">&middot; <time datetime="{{ day.format('Y-m-d') }}" data-localtime-format="day">{{ day.format('D j M')|lower }}</time> &middot; {{ figures.onTheWatchNow }} on the watch &middot; {{ figures.day.checkedIn }} check-ins in</span></span>
        <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::PLAN_ROUTE'), {uuid: area.uuid, day: day.format('Y-m-d')}) }}">Edit the day &rarr;</a>

        {% if not filter.isEverything %}
            <div class="rfrag"><b>{{ posts|length }} post{{ posts|length == 1 ? '' : 's' }} match</b><em>the figures above are the whole day&rsquo;s, not this selection&rsquo;s</em></div>
        {% endif %}

        <div class="rscroll" data-roster--bound-target="scroller">
            {{ include('@UhifadhiRoster/today/_agenda.html.twig', {posts: posts, reported: true, empty: filter.isEverything ? 'No post is on the roster’s books' : 'Nothing matches that', emptyWhy: filter.isEverything ? 'a watch is given to a post deliberately, so none is assumed' : 'no watch on this day is both at these posts and in that state'}) }}
        </div>
    </div>

    <h2 class="zone">Tomorrow</h2>
    <div class="c" data-controller="roster--bound">
        <span class="tab">Tomorrow<span class="src">&middot; <time datetime="{{ tomorrow.format('Y-m-d') }}" data-localtime-format="day">{{ tomorrow.format('D j M')|lower }}</time> &middot; {{ figures.onTheWatchTomorrow }} on the watch</span></span>
        <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::WEEK_ROUTE'), {uuid: area.uuid}) }}">The fortnight &rarr;</a>

        <div class="rscroll" data-roster--bound-target="scroller">
            {{ include('@UhifadhiRoster/today/_agenda.html.twig', {posts: tomorrowPosts, reported: false, empty: 'Nothing is rostered for tomorrow', emptyWhy: 'the pattern has not been generated this far, or every post is off'}) }}
        </div>
    </div>
{% endblock %}

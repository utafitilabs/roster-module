{# ============================================================================
   TODAY — the agenda, ported from the design's modules/roster/today.html.

   THE PAGE IS: the index (Today · Tomorrow), the filter row, then the two
   days, one column, each the house register. Two days and no more — the
   agenda's whole trade-off is that it answers "what is happening" completely
   and says nothing about the week, which is the next tab's job and its door
   is on the second card. The band and the figures are the Overview's.
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · today{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}Who is due, and what the positions say about them. The watch is the roster&rsquo;s; the state beside it is the area&rsquo;s reading of a ranger&rsquo;s own check-in.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / today{% endblock %}

{% block roster_page %}
    {% embed '@Shell/_onpage.html.twig' with {rows: [
        {id: 'today', label: isToday ? 'Today' : 'The day'},
        {id: 'tomorrow', label: 'Tomorrow'},
    ], area: area, day: day, isToday: isToday, tomorrow: tomorrow, filter: filter, posts: posts, tomorrowPosts: tomorrowPosts,
       todayTable: todayTable, tomorrowTable: tomorrowTable,
       chosenPost: chosenPost, allPosts: allPosts, stateLabels: stateLabels, stateCounts: stateCounts, shiftLabels: shiftLabels, shiftCounts: shiftCounts,
       figures: figures} only %}
        {% block shell_onpage_main %}
            {{ include('@UhifadhiRoster/today/_filters.html.twig') }}

            <div class="c" id="today" data-controller="roster--bound">
                <span class="tab">{{ isToday ? 'Today' : 'The day' }}<span class="src">&middot; <time datetime="{{ day.format('Y-m-d') }}" data-localtime-format="day">{{ day.format('D j M')|lower }}</time> &middot; {{ figures.onTheWatchNow }} on the watch &middot; {{ figures.day.checkedIn }} check-ins in</span></span>
                <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::PLAN_ROUTE'), {uuid: area.uuid, day: day.format('Y-m-d')}) }}">Edit the day &rarr;</a>
                {# BOUNDED — RULED 25 sep, the sheet's height rule: the register
                   scrolls inside its card under a head that stays. #}
                <div class="rscroll" data-roster--bound-target="scroller">{{ include('@UhifadhiRoster/today/_agenda.html.twig', {area: area, rows: todayTable.rows, reported: true, empty: filter.isEverything ? 'No post is on the roster’s books.' : 'Nothing today matches.'}, with_context: false) }}</div>
                {{ include('@Shell/_foot.html.twig', todayTable.foot, with_context: false) }}
            </div>

            <div class="c" id="tomorrow" data-controller="roster--bound">
                <span class="tab">Tomorrow<span class="src">&middot; <time datetime="{{ tomorrow.format('Y-m-d') }}" data-localtime-format="day">{{ tomorrow.format('D j M')|lower }}</time> &middot; {{ figures.onTheWatchTomorrow }} on the watch</span></span>
                <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::WEEK_ROUTE'), {uuid: area.uuid}) }}">The fortnight &rarr;</a>
                <div class="rscroll" data-roster--bound-target="scroller">{{ include('@UhifadhiRoster/today/_agenda.html.twig', {area: area, rows: tomorrowTable.rows, reported: false, empty: filter.isEverything ? 'Nothing is rostered for tomorrow.' : 'Nothing tomorrow matches.'}, with_context: false) }}</div>
                {{ include('@Shell/_foot.html.twig', tomorrowTable.foot, with_context: false) }}
            </div>
        {% endblock %}
    {% endembed %}
{% endblock %}

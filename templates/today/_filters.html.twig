{# ============================================================================
   THE FILTER ROW — post, check-in state and shift, then the search. Today,
   the Day board and Live wear it.

   THE ROW IS THE HOUSE BAR, `.lfilt` (`@UhifadhiRoster/_lfilt.html.twig`):
   every option is a link carrying the whole question, so a filtered page is
   an address somebody can send and the back button undoes a choice.

   THE COUNTS ARE COUNTED FROM THE SAME READING THE ROWS CAME FROM, never
   queried again: an option that says "1 unverified" and a list that shows
   none is the one way a filter bar loses its reader. The post menu lists
   every post of the day, whatever the rows are narrowed to — a menu that
   offered only what is showing could never change it.
   ========================================================================== #}
{% import '@UhifadhiRoster/_lfilt.html.twig' as bar %}
{% set here = here|default(constant('Uhifadhi\\Roster\\Controller\\RosterController::TODAY_ROUTE')) %}
{% set base = {uuid: area.uuid}|merge(isToday ? {} : {from: day.format('Y-m-d')}) %}

<div class="lfilt">
    {%- set options = [{label: 'All posts with a watch', count: allPosts|length, href: path(here, base|merge(filter.withPost(null).toQuery)), on: filter.post is null}] -%}
    {%- for post in allPosts -%}
        {%- set options = options|merge([{label: post.stationName, count: post.rostered|length, href: path(here, base|merge(filter.withPost(post.stationUuid).toQuery)), on: filter.post == post.stationUuid}]) -%}
    {%- endfor -%}
    {{ bar.chip('Filter by post', options) }}

    {%- set options = [{label: 'Every state', count: stateCounts.all|default(0), href: path(here, base|merge(filter.withState(null).toQuery)), on: filter.state is null}] -%}
    {%- for value, label in stateLabels -%}
        {%- set options = options|merge([{label: label, count: stateCounts[value]|default(0), href: path(here, base|merge(filter.withState(value).toQuery)), on: filter.state == value}]) -%}
    {%- endfor -%}
    {{ bar.chip('Filter by check-in state', options) }}

    {%- set options = [{label: 'All shifts', count: stateCounts.all|default(0), href: path(here, base|merge(filter.withShift(null).toQuery)), on: filter.shift is null}] -%}
    {%- for key, label in shiftLabels -%}
        {%- set options = options|merge([{label: label, count: shiftCounts[key]|default(0), href: path(here, base|merge(filter.withShift(key).toQuery)), on: filter.shift == key}]) -%}
    {%- endfor -%}
    {{ bar.chip('Filter by shift', options) }}

    {{ bar.search(path(here, {uuid: area.uuid}), (isToday ? {} : {from: day.format('Y-m-d')})|merge(filter.toQuery), 'q', filter.q, searchPlaceholder|default('Find a ranger or a post…')) }}
</div>

{# ============================================================================
   THE ROSTER'S WIDGET LIBRARY — the FIRST section of the module's configure
   page, exactly where every other module in the platform keeps it.

   IT IS NOT A DOOR ON THE DASHBOARD. Editing never happens on the surface
   being edited; the dashboard carries no customize control at all, and this
   screen is reached from the configure strip like Rotation, Watches and
   Settings.

   THE PAGE IS ONLY CHROME. Everything below the note is the shell's own
   preset component, identical on every surface that ships a catalogue and
   parameterised by this one's catalogue, partial name and routes. There are
   no roster-specific widget mechanics anywhere.

   AREA-SCOPED: every url the component is handed names this area, so
   arranging one area's roster leaves every other area's alone.
   ========================================================================== #}
{% extends '@UhifadhiRoster/configure/_frame.html.twig' %}

{% block title %}Roster · widget library{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# type="module" is deferred by definition, so the library is armed after
       the DOM exists. The script is the widget framework's — one library,
       every surface. #}
    <script type="module">
        import { initWidgetLibrary } from 'uhifadhi/widgets';
        initWidgetLibrary();
    </script>
{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / configure / widgets{% endblock %}

{% block shell_page_actions %}
    {# ONE RESET PER SURFACE, EACH NAMING ITS OWN. A page with two libraries
       has two compositions to throw away, and a button that did not say
       which one it resets is not a button anything can act on safely — the
       framework ignores a bare one here for exactly that reason.

       Throwing a composition away asks first, through the shell's reusable
       confirm modal and never the browser's own dialog. #}
    <button type="button" class="tgl w-act" {{ constant('Uhifadhi\\Bundle\\ShellBundle\\Widget\\Model\\WidgetDom::RESET') }}="{{ constant('Uhifadhi\\Roster\\Widget\\RosterWidgets::SURFACE') }}"
            {{ stimulus_controller('confirm-modal') }}
            data-action="click->confirm-modal#ask"
            data-confirm-modal-title-value="Reset the dashboard layout?"
            data-confirm-modal-message-value="This area's roster dashboard goes back to the composition the module ships with. Your own designs are kept, the organization roster is untouched, and your other areas are untouched."
            data-confirm-modal-confirm-label-value="Reset the dashboard"
            data-confirm-modal-danger-value="true">{{ ux_icon('shell:rotate-ccw') }}Reset the dashboard</button>
{% endblock %}

{% block roster_section %}
    {# THE PAGE IS ONLY CHROME. Everything below is the shell's own preset
       component, given BOTH of this module's surfaces: one house section
       each, each with its own catalogue, presets, routes and token.
 #}
    <div class="rfrag"><b>Two compositions, one place to change them</b><em>the roster&rsquo;s Overview is this area&rsquo;s page of cards and the organization roster reads every area at once. They share the mechanism and nothing else, and both are arranged here.</em></div>

    {{ include('@Shell/widget/_library.html.twig', {surfaces: surfaces}, with_context: false) }}
{% endblock %}

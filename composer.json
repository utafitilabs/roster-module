{
    "name": "uhifadhi/roster-module",
    "description": "Roster: who is due on watch, where and when — rotations that generate duties, swaps and absences, and the on-duty presence read back from the area's check-ins.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony-ux",
        "roster",
        "duty-roster",
        "rotation",
        "shifts",
        "presence",
        "conservation",
        "symfony",
        "uhifadhi"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/utafitilabs/uhifadhi"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/dbal": "^4.0",
        "psr/clock": "^1.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.5",
        "symfony/asset": "^7.3 || ^8.0",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/routing": "^7.3 || ^8.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/ux-icons": "^2.20 || ^3.0",
        "uhifadhi/uhifadhi": "^1.0@dev"
    },
    "require-dev": {
        "api-platform/core": "^4.4",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/clock": "^7.3 || ^8.0",
        "symfony/css-selector": "^7.3 || ^8.0",
        "symfony/security-bundle": "^7.3 || ^8.0",
        "symfony/security-core": "^7.3 || ^8.0",
        "symfony/security-csrf": "^7.3 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^2.30 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Roster\\": "src/",
            "Uhifadhi\\Roster\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Roster\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@cs:check",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
